app = "caption-this-api"
primary_region = "ord"

[build]
  dockerfile = "Dockerfile"

[env]
  DATA_DIR = "/data"
  WHISPER_DEVICE = "cpu"
  WHISPER_COMPUTE_TYPE = "int8"
  # Set CORS_ORIGINS via `fly secrets set`

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 0

[mounts]
  source = "caption_data"
  destination = "/data"

[[vm]]
  cpu_kind = "shared"
  cpus = 2
  memory_mb = 2048
