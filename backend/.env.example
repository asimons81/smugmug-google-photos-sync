# Caption This Backend Configuration

# Directory for job data (uploads, outputs)
DATA_DIR=../data

# CORS origins (comma-separated). Use * for local dev.
CORS_ORIGINS=*

# Maximum upload file size in bytes (default: 500MB)
MAX_FILE_SIZE=524288000

# Whisper settings
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Default model if not specified in request
WHISPER_DEFAULT_MODEL=base
